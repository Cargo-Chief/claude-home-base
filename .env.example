# Copy this template to ~/.config/cargo-chief/home-base.env (chmod 600).
# Do not create a .env inside this repository. Set CARGO_CHIEF_ENV_FILE in the
# launchd service only when the external path differs from that default.

# Slack tokens — get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Authorized Slack user IDs (comma-separated)
# Find your ID: Slack profile → ⋮ → Copy member ID
# Required. The bot refuses startup when this is empty.
AUTHORIZED_USERS=

# Required. Slack user IDs allowed to approve an explicitly gated action.
# Every approver must also appear in AUTHORIZED_USERS.
CARGO_CHIEF_APPROVERS=

# Working directories and permission modes are configured per room in
# model-config.json. Cargo Chief rooms accept only permission_mode "auto".

# Gate A runtime controls. Runtime data stays outside the repository; file
# transfer, transcript indexing, parallel sessions, and long turns fail closed.
CARGO_CHIEF_RUNTIME_DIR=/Users/eng-agent/.local/state/cargo-chief/home-base
CLAUDE_TIMEOUT=600
MAX_LIVE_SESSIONS=1
ENABLE_FILE_TRANSFER=false
ENABLE_TRANSCRIPT_SEARCH=false

# Optional per-principal local identity. Initialize it with:
#   python3 agent_identity.py init
# The service fails closed if a configured store is missing, symlinked, too open,
# or malformed. Never point two Unix principals at the same directory.
CARGO_CHIEF_IDENTITY_DIR=/Users/eng-agent/.local/share/cargo-chief/identity

# HTTP server port (Cloudflare Tunnel points to this)
PORT=3000

# Bot identity — used in thread context and logging
# Find your bot's user ID at: https://api.slack.com/apps → your app → Basic Information
BOT_USER_ID=
BOT_DISPLAY_NAME=Your AI Employee

# --- Channel filtering ---

# Only respond in channels whose names start with these prefixes (comma-separated).
# Leave empty to respond in all channels.
ALLOWED_CHANNELS=

# --- Trust battery ---

# Path to directory containing per-user trust battery JSON files.
# Leave empty to disable. See trust-battery/README.md for setup.
TRUST_BATTERY_DIR=

# The Codex backend is deliberately disabled during Gate A because it does not
# yet have Cargo Chief governance parity.

# --- Extensions ---

# Gemini API — image generation
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API — high-quality image generation (gpt-image-2)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
